# Copy to .env (already gitignored). Never commit real values.

# --- Django core ---
DEBUG=False
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=asdfasdfasd
ALLOWED_HOSTS=.faablab.app,.herokuapp.com,127.0.0.1,localhost

# --- Database ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=True

# --- Frontend origins ---
CORS_ALLOWED_ORIGINS=https://www.faablab.app,https://faablab.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://www.faablab.app,https://faablab.app

# --- Cache (optional; falls back to in-process memory) ---
REDIS_URL=
WEEK_CACHE_SECONDS=60

# --- Anonymous bid identity (defaults to SECRET_KEY if unset) ---
SUBMITTER_SIGNING_SALT=

# --- Write throttles ---
THROTTLE_BID_BURST=10/min
THROTTLE_BID_SUSTAINED=120/day

# --- Sleeper ingest ---
# Sleeper documents a 1000/min ceiling; stay well under it.
SLEEPER_RATE_LIMIT_PER_MIN=300
SLEEPER_MAX_WORKERS=8
SLEEPER_TIMEOUT=15
SLEEPER_USER_AGENT=faablab/2.0 (+https://faablab.app)

# Maps the old running week counter to real NFL weeks: nfl_week = legacy - offset.
# Comma-separated season:offset pairs. Append a season only if something still
# calls /api/targets or /api/stats with a bare ?week= and no season -- the
# redesigned page passes season explicitly and ignores this entirely.
#   2024:28  means legacy week 29 was NFL week 1 (from faab_value_metrics_2024.json)
# To add a season:  offset = <legacy number you use for week 1> - 1
# e.g. LEGACY_WEEK_OFFSETS=2024:28,2026:45
LEGACY_WEEK_OFFSETS=2024:28

# --- Public data API (optional; the API works without any of these) ---
SITE_URL=https://www.faablab.app
# Key creation is self-serve by design; this only stops one address minting thousands.
THROTTLE_API_SIGNUP=20/day

# Billing. With none of these set, upgrade links fall back to the pricing page
# and tiers are changed by hand -- fine for the first few customers.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HOBBY=
STRIPE_PRICE_PRO=
# Shortcut: a hosted Stripe Payment Link, used when the keys above are unset.
STRIPE_PAYMENT_LINK=

# --- API docs ---
# Serves /api/docs (Swagger UI), /api/redoc and /api/schema.
ENABLE_API_DOCS=True

LOG_LEVEL=INFO
